# Hive-Mind environment — PLACEHOLDERS ONLY. Never put real values in git.
# Copy to .env only when a later block needs these. Block 1 ignores them.
#
# Meta Model API (Block 4). No calls are made before Block 4, and only
# after the $150 free-credit / $100 spend-warning guard is verified.
# META_API_KEY=
#
# Supabase snapshot hook (Block 5). Sync/backup only; SQLite stays primary.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Local paths (Block 1). Defaults work with no .env at all.
# HIVE_MIND_DB_PATH=data/hive-mind.db
# HIVE_MIND_VAULT_DIR=vault
# EMBED_DIM=768

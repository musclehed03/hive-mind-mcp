# Hive-Mind environment — PLACEHOLDERS ONLY. Never put real values in git.
# Copy to .env only on the machine that runs a live gate. With nothing
# configured, the factory always returns the fake clients.
#
# Live switch: NEVER set to 1 in a committed file. Set it in the shell
# only, for the duration of one live gate, then unset it.
# HIVE_MIND_LIVE=0
#
# Meta Model API (Block 4). No live calls are made unless
# HIVE_MIND_LIVE=1, and only after the $150 free-credit / $100
# spend-warning guard is verified. Hard budget: 5 calls per process.
# META_API_KEY=
# HIVE_MIND_META_MODEL=muse-spark-1.3
# HIVE_MIND_META_BASE_URL=https://api.meta.ai/v1
# HIVE_MIND_LIVE_MAX_CALLS=5
# (Raising the budget past 5 requires HIVE_MIND_LIVE_UNSAFE_RAISE_BUDGET=1
#  in the shell; that override is documented as unsafe. Do not set it
#  in a file.)
#
# Supabase snapshot hook (Block 5). Sync/backup only; SQLite stays primary.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# HIVE_MIND_SUPABASE_BUCKET=hive-mind-snapshots
#
# Local paths (Block 1). Defaults work with no .env at all.
# HIVE_MIND_DB_PATH=data/hive-mind.db
# HIVE_MIND_VAULT_DIR=vault
# EMBED_DIM=768
